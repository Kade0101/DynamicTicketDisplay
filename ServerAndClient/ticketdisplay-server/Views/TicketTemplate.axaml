<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TicketDisplayAppModified.Views.TicketTemplate"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="240"
             MinHeight="260">
    <Grid x:Name="RootGrid">
        <Border CornerRadius="24"
                ClipToBounds="True"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="24,0,0,24"
                    Padding="32,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ColorNameText"
                               Text="GREY"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#6B7280"
                               LetterSpacing="1"/>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="-6">
                        <TextBlock x:Name="LetterText"
                                   Text="A"
                                   HorizontalAlignment="Center"
                                   FontSize="78"
                                   FontWeight="ExtraBold"
                                   FontFamily="Segoe UI Black"
                                   Foreground="#374151" />
                        <TextBlock x:Name="RaffleText"
                                   Text="123"
                                   HorizontalAlignment="Center"
                                   FontSize="118"
                                   FontWeight="ExtraBold"
                                   FontFamily="Segoe UI Black"
                                   Foreground="#111827" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ColorStrip"
                    Grid.Column="1"
                    Background="Gray"
                    CornerRadius="0,24,24,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

                <Border x:Name="OverlayBorder"
                        Grid.ColumnSpan="2"
                        BorderBrush="#D1D5DB"
                        BorderThickness="3"
                        CornerRadius="24"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        ZIndex="1"
                        Opacity="1"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
