<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TicketDisplayAppModified.Views.MainWindow"
        Title="Raffle Display"
        Width="1280" Height="720"
        Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinitions>Auto,*,Auto</RowDefinitions>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#F3F4F6"/>

        <Border Grid.Row="0"
                Margin="70,28,40,18"
                Padding="0,0,0,0"
                Background="Transparent"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinitions>*,Auto</ColumnDefinitions>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="CURRENT PRIZE"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#6B7280"
                               LetterSpacing="1"/>
                    <TextBlock x:Name="PrizeText"
                               HorizontalAlignment="Center"
                               Text="2x Meat Trays"
                               FontSize="60"
                               FontWeight="ExtraBold"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               MaxWidth="900"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="10"
                        Background="#FFFFFF"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="LIVE DISPLAY"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               LetterSpacing="0.5"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="100,8,100,24">
            <Grid.RowDefinitions>
                <RowDefinitions>Auto,*</RowDefinitions>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinitions>*,100,*</ColumnDefinitions>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="3"
                       Text="LATEST TICKETS"
                       Margin="4,0,0,14"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#6B7280"
                       LetterSpacing="1"/>

            <Border Grid.Row="1" Grid.Column="0"
                    CornerRadius="20"
                    Padding="12"
                    Background="#6B7280"
                    BorderBrush="#E5E7EB"
                    BorderThickness="2">
                <ContentControl x:Name="TicketSlot1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
            </Border>

            <Border Grid.Row="1" Grid.Column="2"
                    CornerRadius="20"
                    Padding="12"
                    Background="#6B7280"
                    BorderBrush="#E5E7EB"
                    BorderThickness="2">
                <ContentControl x:Name="TicketSlot2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
            </Border>

            <Canvas x:Name="OverlayCanvas"
                    IsHitTestVisible="False"
                    Panel.ZIndex="100"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"/>
        </Grid>

        <Border Grid.RowSpan="3"
                x:Name="DarkOverlay"
                Background="#99000000"
                Opacity="0"
                IsVisible="False"
                IsHitTestVisible="False"
                ZIndex="99">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Padding="20,14"
                    CornerRadius="14"
                    Background="#F8FAFC"
                    IsVisible="True">
                <TextBlock x:Name="LogTextBlock"
                           Text="DEBUGTEXTHERE"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1100"
                           IsVisible="True"/>
            </Border>
        </Border>

        <Border Grid.Row="2"
                Background="#E5E7EB"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Version 1.2.8"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#6B7280"/>

                <Button Grid.Column="2" Content="Debug Ticket"
                        MinWidth="110" Height="32"
                        Margin="8,0,0,0"
                        CornerRadius="8"
                        Click="OnDebugTicketClick"/>
                <Button Grid.Column="3" Content="Debug Ticket 2"
                        MinWidth="120" Height="32"
                        Margin="8,0,0,0"
                        CornerRadius="8"
                        Click="OnDebugTicket2Click"/>
                <Button Grid.Column="4" Content="Clear Tickets"
                        MinWidth="120" Height="32"
                        Margin="8,0,0,0"
                        CornerRadius="8"
                        Click="OnClearTicketsClick"/>
                <Button Grid.Column="5" Content="Redraw Ticket 1"
                        MinWidth="130" Height="32"
                        Margin="8,0,0,0"
                        CornerRadius="8"
                        Click="OnRedrawTickets1Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
