<Window x:Class="RaffleDisplayApplication.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raffle Input"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#101B2D">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.12"/>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#357ab8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285a99"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1d406b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClearTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#f4f6fa"/>
            <Setter Property="Foreground" Value="#101B2D"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#357ab8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="CaretBrush" Value="#357ab8"/>
        </Style>
        <Style x:Key="ClearComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#f4f6fa"/>
            <Setter Property="Foreground" Value="#101B2D"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#357ab8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="#182544"
                CornerRadius="32"
                Effect="{StaticResource CardShadow}"
                Padding="60"
                MinWidth="500"
                MinHeight="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Enter Ticket Details"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="#357ab8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>
                <!-- Raffle Number -->
                <TextBlock Text="Raffle Number"
                           Foreground="#357ab8"
                           FontSize="20"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="RaffleInput"
                         Style="{StaticResource ClearTextBoxStyle}"/>
                <!-- Letter -->
                <TextBlock Text="Letter"
                           Foreground="#357ab8"
                           FontSize="20"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="LetterInput"
                         Style="{StaticResource ClearTextBoxStyle}"/>
                <!-- Colour -->
                <TextBlock Text="Colour"
                           Foreground="#357ab8"
                           FontSize="20"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="ColorInput"
                          Style="{StaticResource ClearComboBoxStyle}"
                          Height="44"
                          FontSize="22"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Grey" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Orange" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Tangerine" />
                    <ComboBoxItem Content="Pink" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Save Ticket"
                            Style="{StaticResource FlatButtonStyle}"
                            Width="180"
                            Click="SaveTicket"/>
                    <Button Content="Cancel"
                            Style="{StaticResource FlatButtonStyle}"
                            Width="120"
                            Click="BackButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>