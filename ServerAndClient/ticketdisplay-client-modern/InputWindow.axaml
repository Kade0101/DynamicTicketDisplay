<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="RaffleDisplayApplication.InputWindow"
    Title="Raffle Input"
    WindowStartupLocation="CenterOwner"
    WindowState="Maximized"
    SystemDecorations="None"
    CanResize="False"
    Background="#101B2D">

    <Window.Styles>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="#357AB8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.flat:pointerover">
            <Setter Property="Background" Value="#285A99" />
        </Style>

        <Style Selector="Button.flat:pressed">
            <Setter Property="Background" Value="#1D406B" />
        </Style>

        <Style Selector="TextBox.ticketInput">
            <Setter Property="Background" Value="#F4F6FA" />
            <Setter Property="Foreground" Value="#101B2D" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#357AB8" />
            <Setter Property="CaretBrush" Value="#357AB8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBox.ticketInput:focus">
            <Setter Property="BorderBrush" Value="#6AA9E0" />
        </Style>

        <Style Selector="ComboBox.ticketInput">
            <Setter Property="Background" Value="#F4F6FA" />
            <Setter Property="Foreground" Value="#101B2D" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#357AB8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border
            Background="#182544"
            CornerRadius="32"
            BoxShadow="0 4 18 0 #33000000"
            Padding="60"
            MinWidth="500"
            MinHeight="400"
            MaxWidth="650"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <StackPanel Spacing="8">
                <TextBlock
                    Text="Enter Ticket Details"
                    FontWeight="Bold"
                    FontSize="32"
                    Foreground="#357AB8"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24" />

                <TextBlock
                    Text="Raffle Number"
                    Foreground="#357AB8"
                    FontSize="20"
                    Margin="0,0,0,4" />

                <TextBox
                    x:Name="RaffleInput"
                    Classes="ticketInput"
                    Watermark="0–100"
                    Margin="0,0,0,16" />

                <TextBlock
                    Text="Letter"
                    Foreground="#357AB8"
                    FontSize="20"
                    Margin="0,0,0,4" />

                <TextBox
                    x:Name="LetterInput"
                    Classes="ticketInput"
                    MaxLength="1"
                    Watermark="A–Z"
                    Margin="0,0,0,16" />

                <TextBlock
                    Text="Colour"
                    Foreground="#357AB8"
                    FontSize="20"
                    Margin="0,0,0,4" />

                <ComboBox
                    x:Name="ColorInput"
                    Classes="ticketInput"
                    Height="48"
                    SelectedIndex="0"
                    Margin="0,0,0,16">

                    <ComboBoxItem Content="Grey" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Orange" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Tangerine" />
                    <ComboBoxItem Content="Pink" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>

                <TextBlock
                    x:Name="ValidationMessage"
                    IsVisible="False"
                    Foreground="#FFB4AB"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10" />

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">

                    <Button
                        Classes="flat"
                        Content="Save Ticket"
                        Width="180"
                        Click="SaveTicket" />

                    <Button
                        Classes="flat"
                        Content="Cancel"
                        Width="120"
                        Click="BackButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
