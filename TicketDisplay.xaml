<UserControl x:Class="RaffleDisplayApplication.TicketDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Border Background="White" CornerRadius="12">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />      <!-- Main content -->
                <ColumnDefinition Width="48" />     <!-- Color strip -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Height="215"
                        Width="160"
                        Margin="32,18,0,0">
                <TextBlock x:Name="ColorNameText" Text="GREY" 
                           Margin="0,0,0,15"
                           Height="32" HorizontalAlignment="Center"
                           FontSize="24" FontWeight="Bold" Foreground="Gray"/>
                <TextBlock x:Name="LetterText" Text="A" 
                           Height="68" Margin="0,0,0,5"
                           HorizontalAlignment="Center"
                           FontSize="54" FontWeight="Bold"
                           FontFamily="Segoe UI Black" Foreground="Gray"/>
                <TextBlock x:Name="RaffleText" Text="123" 
                           Height="75" HorizontalAlignment="Center"
                           FontSize="62" FontWeight="Bold"
                           FontFamily="Segoe UI Black" Foreground="Gray"/>
            </StackPanel>

            <Border x:Name="ColorStrip"
                    Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                    Background="Gray"
                    Width="48"
                    HorizontalAlignment="Stretch"
                    CornerRadius="0,12,12,0"/>
        </Grid>
    </Border>
</UserControl>
