<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TicketDisplayAppModified.Views;assembly=TicketDisplayAppModified"
        x:Class="TicketDisplayAppModified.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="TicketDisplayAppModified"
        Width="800" Height="450">

	<DockPanel>

		<!-- Bottom version bar -->
		<Border DockPanel.Dock="Bottom" Background="Gray" Height="30">
			<TextBlock Text="Version 1.0.0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="10"
                       Foreground="White"/>
		</Border>

		<!-- Main content view -->
		<ContentControl x:Name="MainViewContainer" />

	</DockPanel>
</Window>
