<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TicketDisplayAppModified.Views"
             x:Class="TicketDisplayAppModified.Views.TicketTemplate"
			 
             >
	<Grid Margin="0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="107*" />
			<ColumnDefinition Width="44*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="1" Grid.ColumnSpan="2"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					Height="215"
					Width="160"
					Margin="56,18,0,0">
			<TextBlock x:Name="ColorNameText"
					   Text="GREY"
					   Margin="0,0,0,15"
					   Height="32"
					   HorizontalAlignment="Center"
					   FontSize="24"
					   FontWeight="Bold"
					   Foreground="Gray" />
			<TextBlock x:Name="LetterText"
					   Text="A"
					   Margin="0,0,0,5"
					   Height="68"
					   HorizontalAlignment="Center"
					   FontSize="54"
					   FontWeight="Bold"
				   FontFamily="Inter"
					   Foreground="Gray" />
			<TextBlock x:Name="RaffleText"
					   Text="123"
					   Height="75"
					   HorizontalAlignment="Center"
					   FontSize="62"
					   FontWeight="Bold"
						FontFamily="Inter"
					   
					   Foreground="Gray" />
		</StackPanel>

		<Border x:Name="ColorStrip"
				Background="Gray"
				Width="64"
				HorizontalAlignment="Left"
				Margin="232,0,0,0"
				CornerRadius="0,6,6,0"
				Grid.RowSpan="2" />
	</Grid>
</UserControl>
