<Window x:Class="RaffleDisplayApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="1000"
        xmlns:local="clr-namespace:RaffleDisplayApplication">
    <Window.Resources>
        <!-- Color Palette -->
        <Color x:Key="NavyColor">#101B2D</Color>
        <Color x:Key="NavyLightColor">#182544</Color>
        <Color x:Key="AccentColor">#357ab8</Color>
        <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
        <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>

        <!-- Card Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.10"/>

        <!-- Flat Button Style -->
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285a99"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1d406b"/>
                </Trigger>
                <!-- Disabled state -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#444B5A"/>
                    <Setter Property="Foreground" Value="#B0B8C1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat ToggleButton Style -->
        <Style x:Key="FlatToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selected (Checked) -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <!-- MouseOver only when NOT checked -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#285a99"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Create Ticket Button Style -->
        <Style x:Key="CreateTicketButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285a99"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1d406b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:TypeToVisibilityConverter x:Key="TicketDisplayVisibilityConverter" TargetType="{x:Type local:TicketDisplay}" />
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush Color="#101B2D"/>
    </Window.Background>
    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top" Height="60" Background="{StaticResource NavyLightBrush}" Effect="{StaticResource CardShadow}">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <Button Content="⟵ Back"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="120"
                        Height="40"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Click="BackButton_Click"/>
                <TextBlock Text="Raffle Display"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="26"
                           Margin="32,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Footer with version and buttons -->
        <Border DockPanel.Dock="Bottom" Height="72" Background="{StaticResource NavyLightBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Version 1.0.2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="32,0,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0">
                    <Button
                        x:Name="ShowOnTVButton"
                        Content="Show on TV"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="180"
                        Height="48"
                        Click="ShowOnTV_Click"/>
                    <Button
                        Content="Clear Screen"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="180"
                        Height="48"
                        Click="ClearScreenOnTV_Click"/>
                    <ToggleButton
                        x:Name="RedrawToggleButton"
                        Content="Redraw"
                        Style="{StaticResource FlatToggleButtonStyle}"
                        Width="180"
                        Height="48"
                        Checked="RedrawToggleButton_Checked"
                        Unchecked="RedrawToggleButton_Unchecked"
                        Margin="0,0,16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (Grid) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ticket Slots Section -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <!-- Center: Ticket slots -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Raffle buttons -->
                    <!-- Right spacer -->
                </Grid.ColumnDefinitions>

                <!-- Ticket Slots Section (centered) -->
                <Border Grid.Column="0"
                        Background="{StaticResource NavyLightBrush}"
                        CornerRadius="24"
                        Effect="{StaticResource CardShadow}"
                        Padding="40"
                        MaxWidth="1200"
                        MinWidth="700"
                        MinHeight="400"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="Current Prize: "
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="CurrentPrizeValue"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="{StaticResource WhiteBrush}"/>
                        </StackPanel>
                        <Grid x:Name="TicketSlotsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- First Ticket Slot -->
                            <StackPanel x:Name="TicketSlot1Panel" Grid.Column="0" Margin="24,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Ticket Slot 1"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,12"
                                           HorizontalAlignment="Center"/>
                                <Border Background="{StaticResource NavyBrush}"
                                        CornerRadius="12"
                                        Padding="32"
                                        MinHeight="220"
                                        Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonUp="TicketSlotBorder_MouseLeftButtonUp"
                                        Tag="1">
                                    <Grid>
                                        <ContentControl x:Name="TicketSlot1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearTicketSlot1Button" Content="✕"
                                                Width="28" Height="28"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-12,-12,0"
                                                Background="Transparent"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                FontSize="16"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="ClearTicketSlot1_Click"
                                                Visibility="{Binding Content, ElementName=TicketSlot1, Converter={StaticResource TicketDisplayVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- Second Ticket Slot -->
                            <StackPanel x:Name="TicketSlot2Panel" Grid.Column="1" Margin="24,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Ticket Slot 2"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,12"
                                           HorizontalAlignment="Center"/>
                                <Border Background="{StaticResource NavyBrush}"
                                        CornerRadius="12"
                                        Padding="32"
                                        MinHeight="220"
                                        Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonUp="TicketSlotBorder_MouseLeftButtonUp"
                                        Tag="2"> <!-- For TicketSlot1, use Tag="1"; for TicketSlot2, use Tag="2" -->
                                    <Grid>
                                        <ContentControl x:Name="TicketSlot2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearTicketSlot2Button" Content="✕"
                                                Width="28" Height="28"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-12,-12,0"
                                                Background="Transparent"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                FontSize="16"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="ClearTicketSlot2_Click"
                                                Visibility="{Binding Content, ElementName=TicketSlot2, Converter={StaticResource TicketDisplayVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Raffle Prize Buttons (right side) -->
                <Border Grid.Column="1"
                        Background="{StaticResource NavyLightBrush}"
                        CornerRadius="24"
                        Effect="{StaticResource CardShadow}"
                        Padding="40,20,40,40"
                        MaxWidth="400"
                        MinWidth="300"
                        MinHeight="400"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" Height="380">
                    <TextBlock Text="Select Prize" FontWeight="Bold" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column ="1" VerticalAlignment="Center" Margin="40,0,40,0">
                    <ToggleButton Style="{StaticResource FlatToggleButtonStyle}" x:Name="BeerPrizeButton" Click="PrizeButton_Click" Width="200" Height="60" Margin="0,16,0,0">
                        2x Jugs of Beer
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource FlatToggleButtonStyle}" x:Name="GiftCardPrizeButton" Click="PrizeButton_Click" Width="200" Height="60" Margin="0,16,0,0">
                        2x $20 Gift Cards
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource FlatToggleButtonStyle}" x:Name="SmallMeatPrizeButton" Click="PrizeButton_Click" Width="200" Height="60" Margin="0,16,0,0">
                        2x Small Meat Trays
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource FlatToggleButtonStyle}" x:Name="LargeMeatPrizeButton" Click="PrizeButton_Click" Width="200" Height="60" Margin="0,16,0,0">
                        1x Large Meat Tray
                    </ToggleButton>
                </StackPanel>

            </Grid>
        </Grid>
    </DockPanel>
</Window>