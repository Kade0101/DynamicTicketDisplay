<Window x:Class="RaffleDisplayApplication.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raffle Input" Height="400" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#f2f2f2">

    <Border CornerRadius="12" Padding="20" Background="White" Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <!-- Title -->
            <TextBlock Text="Enter Raffle Ticket" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#333" TextAlignment="Center" 
                       Margin="0,0,0,10"/>

            <!-- Raffle Number -->
            <StackPanel>
                <TextBlock Text="Raffle Number" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,5"/>
                <TextBox Name="RaffleInput" Height="30" FontSize="14" Padding="5"/>
            </StackPanel>

            <!-- Letter -->
            <StackPanel>
                <TextBlock Text="Letter" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,5"/>
                <TextBox Name="LetterInput" Height="30" FontSize="14" Padding="5"/>
            </StackPanel>

            <!-- Color Dropdown -->
            <StackPanel>
                <TextBlock Text="Colour" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,5"/>
                <ComboBox Name="ColorInput" Height="30" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="Grey" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Orange" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Tangerine" />
                    <ComboBoxItem Content="Pink" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Show on TV" Width="120" Height="32" Margin="5,5,5,5" Background="#007ACC" Foreground="White" Click="ShowOnTV_Click"/>
                <Button Content="Clear TV" Width="70" Height="32" Margin="5,5,5,5" Background="#444" Foreground="White" Click="ShowOnTV_Click"/>
                <Button Content="History" Width="100" Height="32" Margin="5,5,5,5" Background="#444" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
